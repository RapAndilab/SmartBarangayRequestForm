# Copy this file to .env and fill in real values for local development.
# On Vercel, set these as Environment Variables in the project settings instead.

DJANGO_SECRET_KEY=generate-a-new-long-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app

BASE_URL=http://localhost:8000

# Gmail SMTP (use a Gmail App Password, not your account password)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
ADMIN_EMAIL=admin@example.com
